# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# Node
node_modules/
.pnpm-store/
dist/
.turbo/
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# napi build artifacts
# Ignore .node binaries everywhere *except* inside the published per-platform
# packages, which legitimately contain real .node files.
*.node
!packages/mille-*/**/*.node

# napi-rs auto-generates index.d.ts next to the .node. The checked-in
# TypeScript surface is in packages/mille/api.d.ts; the generated
# file is a build artifact.
packages/mille/index.d.ts

# napi-rs artifacts dir (output of `napi build` before distribution)
artifacts/

# Written into each platform package by scripts/release-notices.mjs at release time, from that
# platform's crate graph. Build output, like the .node beside it.
packages/mille-*/THIRD_PARTY_NOTICES.txt

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
*~

# Environment
.env
.env.*
!.env.example

# Working record from scripts/migrate-trusted-publishers.sh
trusted-publishers-before.tsv
trusted-publishers-done.txt
