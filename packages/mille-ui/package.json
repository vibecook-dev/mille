{
  "name": "@vibecook/mille-ui",
  "version": "0.3.3",
  "description": "React file-tree UI companion to @vibecook/mille. Virtualized, accessible, VS Code File Icon Theme compatible.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/vibecook-dev/mille"
  },
  "homepage": "https://github.com/vibecook-dev/mille#readme",
  "bugs": {
    "url": "https://github.com/vibecook-dev/mille/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./icons/default": {
      "types": "./dist/icons-default.d.ts",
      "import": "./dist/icons-default.js"
    },
    "./icons/duotone": {
      "types": "./dist/icons-duotone.d.ts",
      "import": "./dist/icons-duotone.js"
    },
    "./icons/material": {
      "types": "./dist/icons-material.d.ts",
      "import": "./dist/icons-material.js"
    },
    "./icons/minimal": {
      "types": "./dist/icons-minimal.d.ts",
      "import": "./dist/icons-minimal.js"
    },
    "./theme/minimal.css": "./dist/theme/minimal.css",
    "./git": {
      "types": "./dist/git.d.ts",
      "import": "./dist/git.js"
    },
    "./git/node": {
      "types": "./dist/git-node.d.ts",
      "import": "./dist/git-node.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js"
    },
    "./editor-state": {
      "types": "./dist/editor-state.d.ts",
      "import": "./dist/editor-state.js"
    },
    "./test-status": {
      "types": "./dist/test-status.d.ts",
      "import": "./dist/test-status.js"
    },
    "./views": {
      "types": "./dist/views.d.ts",
      "import": "./dist/views.js"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js"
    },
    "./agent-rules": {
      "types": "./dist/agent-rules.d.ts",
      "import": "./dist/agent-rules.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./a11y": {
      "types": "./dist/a11y.d.ts",
      "import": "./dist/a11y.js"
    },
    "./tailwind-preset": {
      "default": "./dist/tailwind-preset.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist",
    "tokens.css",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build && node scripts/build-tokens.mjs",
    "build:material": "node scripts/build-material.mjs",
    "prepublishOnly": "node scripts/build-material.mjs && pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-tests.mjs",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "bench": "node bench/scroll-expand.mjs",
    "bench:navigation": "node bench/navigation-state.mjs",
    "bench:active-policy": "node bench/active-entry-policy.mjs",
    "bench:file-actions": "node bench/file-action-path.mjs",
    "bench:search-scope": "node bench/file-search-scope.mjs",
    "bench:collapse": "node bench/collapse-descendants.mjs",
    "bench:diagnostics": "node bench/diagnostics-update.mjs",
    "bench:editor-state": "node bench/editor-state-update.mjs",
    "bench:test-status": "node bench/test-status-update.mjs",
    "bench:views": "node bench/views-update.mjs",
    "bench:history": "node bench/history-scm.mjs",
    "bench:commands": "node bench/command-lifecycle.mjs"
  },
  "size-limit": [
    {
      "name": "headless (SPEC §12 target; 15 KB ratchet after Phase-5 enablement on registry)",
      "path": "dist/headless.js",
      "limit": "15 KB",
      "gzip": true,
      "ignore": [
        "react",
        "react-dom",
        "@vibecook/mille",
        "@tanstack/react-virtual",
        "@radix-ui/react-context-menu",
        "@radix-ui/react-dialog",
        "@radix-ui/react-tooltip"
      ]
    },
    {
      "name": "index (SPEC §12 target 45 KB, limit 75 KB)",
      "path": "dist/index.js",
      "limit": "75 KB",
      "gzip": true,
      "ignore": [
        "react",
        "react-dom",
        "@vibecook/mille",
        "@tanstack/react-virtual",
        "@radix-ui/react-context-menu",
        "@radix-ui/react-dialog",
        "@radix-ui/react-tooltip"
      ]
    }
  ],
  "peerDependencies": {
    "@radix-ui/react-context-menu": "^2.0.0",
    "@radix-ui/react-dialog": "^1.0.0",
    "@radix-ui/react-tooltip": "^1.0.0",
    "@tanstack/react-virtual": "^3.0.0",
    "@vibecook/mille": "workspace:^",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@radix-ui/react-context-menu": {
      "optional": true
    },
    "@radix-ui/react-dialog": {
      "optional": true
    },
    "@radix-ui/react-tooltip": {
      "optional": true
    }
  },
  "devDependencies": {
    "@radix-ui/react-context-menu": "^2.0.0",
    "@radix-ui/react-dialog": "^1.0.0",
    "@radix-ui/react-tooltip": "^1.0.0",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@tanstack/react-virtual": "^3.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "happy-dom": "^15.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "size-limit": "^11.0.0",
    "tslib": "^2.8.1",
    "typescript": "~6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
